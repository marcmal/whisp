{
    "version": 6,
    "include": [
        "base.json",
        "os/linux.json",
        "compilers/clang.json"
    ],
    "configurePresets": [
        {
            "name": "x64-linux-clang-static",
            "inherits": [
                "base",
                "linux",
                "clang"
            ],
            "displayName": "x64 linux clang static libs",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-clang-static"
            }
        },
        {
            "name": "x64-linux-clang-dynamic",
            "inherits": "x64-linux-clang-static",
            "displayName": "x64 linux clang dynamic libs",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": true,
                "VCPKG_TARGET_TRIPLET": "x64-linux-clang-dynamic"
            }
        },
        {
            "name": "x64-linux-clang-tidy",
            "inherits": "x64-linux-clang-dynamic",
            "displayName": "x64 linux clang tidy",
            "cacheVariables": {
                "CLANG_TIDY_ENABLE": "ON"
            }
        },
        {
            "name": "x64-linux-clang-sanitizers",
            "inherits": "x64-linux-clang-dynamic",
            "displayName": "x64 linux clang sanitizers",
            "cacheVariables": {
                "SANITIZERS_ENABLE": "ON"
            }
        },
        {
            "name": "x64-linux-clang-coverage",
            "inherits": "x64-linux-clang-dynamic",
            "displayName": "x64 linux clang source-based coverage",
            "cacheVariables": {
                "COVERAGE_SOURCE_ENABLE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-linux-clang-static",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-static"
        },
        {
            "name": "x64-linux-clang-dynamic",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-dynamic"
        },
        {
            "name": "x64-linux-clang-tidy",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-tidy"
        },
        {
            "name": "x64-linux-clang-sanitizers",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-sanitizers"
        },
        {
            "name": "x64-linux-clang-coverage",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-coverage"
        }
    ],
    "testPresets": [
        {
            "name": "x64-linux-clang-static",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-static"
        },
        {
            "name": "x64-linux-clang-dynamic",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-dynamic"
        },
        {
            "name": "x64-linux-clang-sanitizers",
            "inherits": "base",
            "configurePreset": "x64-linux-clang-sanitizers"
        }
    ],
    "workflowPresets": [
        {
            "name": "x64-linux-clang-static",
            "steps": [
                {
                    "type": "configure",
                    "name": "x64-linux-clang-static"
                },
                {
                    "type": "build",
                    "name": "x64-linux-clang-static"
                },
                {
                    "type": "test",
                    "name": "x64-linux-clang-static"
                }
            ]
        },
        {
            "name": "x64-linux-clang-dynamic",
            "steps": [
                {
                    "type": "configure",
                    "name": "x64-linux-clang-dynamic"
                },
                {
                    "type": "build",
                    "name": "x64-linux-clang-dynamic"
                },
                {
                    "type": "test",
                    "name": "x64-linux-clang-dynamic"
                }
            ]
        }
    ]
}
